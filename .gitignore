# Build output
/target/
/dist/

# Vendored C++ libraries. They are downloaded at pinned versions and built by
# scripts/setup.ps1 (not committed).
/scintilla/
/lexilla/

# Copies of files the previous (Electron) build produces. scripts/setup.ps1
# restores them from old-src/ (running `npm install` / build-whiteboard.js if
# needed), so they are not committed twice.
/assets/mermaid.min.js
/assets/whiteboard/whiteboard.bundle.js
/assets/whiteboard/whiteboard.bundle.css
/assets/whiteboard/excalidraw-fonts/

.env
.DS_Store
Thumbs.db
*.log
.claude/

# Code-signing private key; the public .cer is committed, the .pfx must stay local.
.signing/
*.pfx

# Toolkit spikes that lost the evaluation (egui, iced), kept locally for reference.
rust-port/
rust-port-iced/
