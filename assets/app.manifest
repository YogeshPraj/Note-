<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity type="win32" name="NotePlusPlus.Native" version="1.0.0.0" processorArchitecture="*"/>
  <description>Note++</description>
  <!-- Visual styles: themed buttons, edits, lists, scroll bars and menus (Windows 11 look). -->
  <dependency>
    <dependentAssembly>
      <assemblyIdentity type="win32" name="Microsoft.Windows.Common-Controls" version="6.0.0.0" processorArchitecture="*" publicKeyToken="6595b64144ccf1df" language="*"/>
    </dependentAssembly>
  </dependency>
  <!-- These load before the program's first line and are not Windows' known DLLs, so Windows would take a copy lying
       beside the exe first. Each is pinned to System32. scripts/package.ps1 fails when the exe imports one not listed. -->
  <file name="bcrypt.dll" loadFrom="%SystemRoot%\system32\bcrypt.dll"/>
  <file name="bcryptprimitives.dll" loadFrom="%SystemRoot%\system32\bcryptprimitives.dll"/>
  <file name="cfgmgr32.dll" loadFrom="%SystemRoot%\system32\cfgmgr32.dll"/>
  <file name="cryptbase.dll" loadFrom="%SystemRoot%\system32\cryptbase.dll"/>
  <file name="dwmapi.dll" loadFrom="%SystemRoot%\system32\dwmapi.dll"/>
  <file name="dxcore.dll" loadFrom="%SystemRoot%\system32\dxcore.dll"/>
  <file name="glu32.dll" loadFrom="%SystemRoot%\system32\glu32.dll"/>
  <file name="msimg32.dll" loadFrom="%SystemRoot%\system32\msimg32.dll"/>
  <file name="oleacc.dll" loadFrom="%SystemRoot%\system32\oleacc.dll"/>
  <file name="opengl32.dll" loadFrom="%SystemRoot%\system32\opengl32.dll"/>
  <file name="userenv.dll" loadFrom="%SystemRoot%\system32\userenv.dll"/>
  <file name="uxtheme.dll" loadFrom="%SystemRoot%\system32\uxtheme.dll"/>
  <file name="version.dll" loadFrom="%SystemRoot%\system32\version.dll"/>
  <file name="winmm.dll" loadFrom="%SystemRoot%\system32\winmm.dll"/>
  <file name="winspool.drv" loadFrom="%SystemRoot%\system32\winspool.drv"/>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <ws2:longPathAware xmlns:ws2="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</ws2:longPathAware>
      <!-- System-DPI aware: drawn sharp at the scale in force when the program starts (Theme::px). On a monitor with a
           different scale Windows stretches the window. -->
      <ws1:dpiAware xmlns:ws1="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true</ws1:dpiAware>
    </windowsSettings>
  </application>
</assembly>
