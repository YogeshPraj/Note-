# Build output
/target/

# Vendored C++ libraries — each is its own git checkout (committing them would
# create broken gitlinks) and holds MinGW build output. Recreate them as the
# README describes; pinned versions are recorded in the commit that added this.
/scintilla/
/lexilla/

# Generated / third-party copies of files the Electron build already produces.
# Restore from the repo root after `npm install` (which runs build:wb):
#   cp src/whiteboard.bundle.js src/whiteboard.bundle.css  scintilla-probe/assets/whiteboard/
#   cp -r src/excalidraw-fonts                              scintilla-probe/assets/whiteboard/
#   cp node_modules/mermaid/dist/mermaid.min.js             scintilla-probe/assets/
/assets/mermaid.min.js
/assets/whiteboard/whiteboard.bundle.js
/assets/whiteboard/whiteboard.bundle.css
/assets/whiteboard/excalidraw-fonts/
